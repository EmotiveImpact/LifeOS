{
  "name": "life-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "dev:phone": "vite --config apps/phone/vite.config.ts apps/phone --port 5174",
    "dev:web": "vite --config apps/web/vite.config.ts apps/web --port 5175",
    "build:phone": "vite build --config apps/phone/vite.config.ts apps/phone",
    "build:web": "vite build --config apps/web/vite.config.ts apps/web",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "ios": "npm --prefix apps/mobile run ios",
    "android": "npm --prefix apps/mobile run android",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "~6.3.5"
  },
  "workspaces": [
    "packages/*",
    "apps/phone",
    "apps/web"
  ]
}
