{
  "expo": {
    "name": "life",
    "slug": "life",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "life",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "app.life.os",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "life uses the microphone only when you choose to talk.",
        "NSSpeechRecognitionUsageDescription": "life turns your words into text on this phone, with your permission.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.life.os",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F6F5F1"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F1"
        }
      ],
      "expo-status-bar",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Life uses only the photos you choose to attach.",
          "cameraPermission": "Life uses the camera when you choose to photograph a meal or a label, scan a barcode or scan a letter.",
          "microphonePermission": "Life uses the microphone only when you choose to talk."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "life reads only the sleep, heart and activity you switch on, to show your readiness and plan your day. It stays on your phone.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "./plugins/withAndroidMinSdk",
        26
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
