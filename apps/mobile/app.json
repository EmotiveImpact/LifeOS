{
  "expo": {
    "name": "life",
    "slug": "life",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "life",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "app.life.os",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "life uses the microphone only when you choose to talk.",
        "NSSpeechRecognitionUsageDescription": "life turns your words into text on this phone, with your permission.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.life.os",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F6F5F1"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": false } }],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F1"
        }
      ],
      "expo-status-bar",
      "expo-audio",
      ["expo-image-picker", {
        "photosPermission": "life uses only the photos you choose to attach.",
        "cameraPermission": "life uses the camera when you choose to scan a letter or take a photo.",
        "microphonePermission": "life uses the microphone only when you choose to talk."
      }],
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
