{
  "expo": {
    "name": "life",
    "slug": "life",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "life",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.life.os",
      "supportsTablet": true
    },
    "android": {
      "package": "app.life.os",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F6F5F1"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F1"
        }
      ],
      "expo-status-bar",
      "expo-audio",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
