{
  "name": "@life/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "life's API: one Web-standard fetch handler (Bun locally, the chosen host in production), Neon Postgres and Better Auth.",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  }
}
