{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": { "@life/brain": ["../../packages/brain/src/index.ts"], "@life/core": ["../../packages/core/src/index.ts"] }
  },
  "include": ["src", "drizzle.config.ts", "../../tests/api"]
}
