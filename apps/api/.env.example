# life API settings. Copy to `.env` for local runs; in production these live only in the host's
# environment, never in the repo and never in the app. The server refuses to start without the
# required ones and names whichever is missing.

# Postgres. The API must connect as a role without superuser or BYPASSRLS (it checks at start-up),
# so row-level security always applies. Locally: `postgres://life_api@127.0.0.1:5432/life`.
DATABASE_URL=

# Better Auth. The secret is at least 32 random characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8787

# Seals wearable and bank tokens at rest: exactly 32 random bytes, base64. `openssl rand -base64 32`.
TOKEN_KEY=

# Extra origins allowed to call sign-in, comma separated. The phone's `life://` scheme is always allowed.
TRUSTED_ORIGINS=

# Sign in with Apple and Google (optional until the client IDs exist).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage for meal photos and scanned letters: Cloudflare R2 or S3 (owner decision; both encrypt at rest).
# R2: STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com and STORAGE_REGION=auto.
# S3: STORAGE_ENDPOINT=https://s3.<region>.amazonaws.com and the bucket's region.
# Give the bucket a lifecycle rule that expires objects under `tmp/` after 1 day. Without these, file routes answer 503.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Days between "Delete account" and the hard delete (default 30, as the delete screen says). 0 deletes at once.
ACCOUNT_GRACE_DAYS=

# The scheduler's secret for POST /jobs/sweep (deletes accounts after the grace period): `openssl rand -base64 32`.
# Locally the server sweeps every hour by itself.
JOBS_SECRET=

# Model providers (decision 7). Each key switches on that provider's models (src/models/registry.ts); with none,
# POST /ai/run answers 503 after its safety, privacy and consent checks. Keys live only here, never in the app.
# The Gemini API key is for trial data (Ama) only: real people's data goes through Google Cloud's EU endpoint.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Billing (fix F-20). RevenueCat's webhook signing secret: in RevenueCat, Integrations, Webhooks, turn on signing and
# point it at https://<api>/billing/revenuecat. REVENUECAT_ENTITLEMENT is the entitlement that unlocks Life (default
# life). BILLING_ENFORCED=1 once the stores are live: then AI, memory search and wearables need a trial or a
# subscription. BILLING_SANDBOX=1 counts TestFlight and internal-testing purchases; never in production.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT=
BILLING_ENFORCED=
BILLING_SANDBOX=

PORT=8787
