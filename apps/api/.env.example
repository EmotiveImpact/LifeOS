# life API settings. Copy to `.env` for local runs; in production these live only in the host's
# environment, never in the repo and never in the app. The server refuses to start without the
# required ones and names whichever is missing.

# Postgres. The API must connect as a role without superuser or BYPASSRLS (it checks at start-up),
# so row-level security always applies. Locally: `postgres://life_api@127.0.0.1:5432/life`.
DATABASE_URL=

# Better Auth. The secret is at least 32 random characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8787

# Seals wearable and bank tokens at rest: exactly 32 random bytes, base64. `openssl rand -base64 32`.
TOKEN_KEY=

# Extra origins allowed to call sign-in, comma separated. The phone's `life://` scheme is always allowed.
TRUSTED_ORIGINS=

# Sign in with Apple and Google (optional until the client IDs exist).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=8787
