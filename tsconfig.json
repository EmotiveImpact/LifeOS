{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@life/core": [
        "packages/core/src/index.ts"
      ],
      "@life/core/engine": [
        "packages/core/src/data/lifeosEngine.ts"
      ],
      "@life/core/types": [
        "packages/core/src/types/lifeos.ts"
      ],
      "@life/core/finance": [
        "packages/core/src/data/finance.ts"
      ],
      "@life/core/health": [
        "packages/core/src/data/health.ts"
      ],
      "@life/core/housing": [
        "packages/core/src/data/housing.ts"
      ],
      "@life/core/growth": [
        "packages/core/src/data/growth.ts"
      ],
      "@life/core/onboarding": [
        "packages/core/src/data/onboarding.ts"
      ],
      "@life/core/gambits": [
        "packages/core/src/data/gambits.ts"
      ],
      "@life/core/weeklyRecap": [
        "packages/core/src/data/weeklyRecap.ts"
      ],
      "@life/phone": [
        "apps/phone/src/index.ts"
      ],
      "@life/phone/components/*": [
        "apps/phone/src/components/*"
      ],
      "@life/web": [
        "apps/web/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages/*/src",
    "apps/phone/src",
    "apps/web/src"
  ]
}
